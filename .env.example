# Copiá este archivo como .env para correr local. NO lo subas al repositorio
# (.env está en .gitignore). En Render estas mismas variables se configuran en
# Dashboard > Service > Environment.

# --- Obligatorias ---
ANTHROPIC_API_KEY=sk-ant-...
APP_TOKEN=poné-aquí-una-cadena-larga-y-aleatoria

# --- Backend de datos: powerbi_service | agente_local | simulado ---
DATA_BACKEND=simulado

# --- Modo A: Power BI Service (dataset publicado + Service Principal) ---
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_DATASET_ID=

# --- Modo B: agente local junto a Power BI Desktop ---
LOCAL_AGENT_URL=
LOCAL_AGENT_TOKEN=

# --- Opcionales ---
CLAUDE_MODEL=claude-sonnet-5
MAX_TOKENS=8000
MAX_TOOL_ROUNDS=14
MAX_ROWS_TO_MODEL=300
MAX_HISTORY_TURNS=16
PORT=3001
