{
  "name": "olo-copiloto-outbound",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consultas en lenguaje natural al modelo de Power BI de expediciones de OLO",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,green \"vite\" \"node --watch server/index.js\"",
    "demo": "cross-env FAKE_LLM=1 DATA_BACKEND=simulado APP_TOKEN=demo ANTHROPIC_API_KEY=no-hace-falta npm run dev",
